# Local template only — replace placeholders on your machine / in Render.
# Never commit the populated .env.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional: when empty, POST /poll is disabled; scheduled polling still works.
POLL_ADMIN_TOKEN=
DATABASE_PATH=/data/clips.sqlite3
POLL_INTERVAL_SECONDS=900
CLIP_LOOKBACK_HOURS=24
MIN_CLIP_VIEWS=100
MAX_CLIPS_PER_POLL=100
KNOWN_CLIPS_LIMIT=20
KNOWN_STREAMERS=ishowspeed,kaicenat,xqc,jynxzi,rubius,jltomy
# Add broadcaster IDs only with explicit permission for video reuse.
ALLOWED_BROADCASTER_IDS=
