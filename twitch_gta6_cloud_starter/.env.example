# Local template only — replace placeholders on your machine / in Render.
# Never commit the populated .env.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional: when empty, POST /poll is disabled; scheduled polling still works.
POLL_ADMIN_TOKEN=
DATABASE_PATH=/data/clips.sqlite3
POLL_INTERVAL_SECONDS=900
CLIP_LOOKBACK_HOURS=24
MIN_CLIP_VIEWS=100
MAX_CLIPS_PER_POLL=100
KNOWN_CLIPS_LIMIT=20
KNOWN_STREAMERS=ishowspeed,kaicenat,xqc,jynxzi,rubius,jltomy
# Add broadcaster IDs only with explicit permission for video reuse.
ALLOWED_BROADCASTER_IDS=
# Video upload processing uses the existing secured admin token.
VIDEO_STORAGE_DIR=/data/videos
VIDEO_MAX_UPLOAD_MB=75
VIDEO_KEEP_HOURS=48
# Run a 65-second synthetic render only once per persisted disk.
VIDEO_SELFTEST_ONCE=0

# Optional: OpenAI Platform API key, separately billed from ChatGPT Plus.
# Required ONLY when explicitly requesting auto_subtitles=true for real video.
OPENAI_API_KEY=
# Autonomous pipeline: enabled only when ALL additional authorizations below exist.
AUTO_PIPELINE_ENABLED=0
AUTO_POSTS_PER_DAY=1
# User OAuth authorization as a broadcaster/editor with scope
# editor:manage:clips or channel:manage:clips; NOT TWITCH_CLIENT_SECRET.
TWITCH_EDITOR_ID=
TWITCH_EDITOR_ACCESS_TOKEN=
# Metricool Advanced/Custom API token, not your ChatGPT Metricool connector token.
# Existing brand ACTU GTA VI (TikTok lactugta6.flash, YouTube ACTU GTA VI)
METRICOOL_API_TOKEN=
METRICOOL_USER_ID=6375809
METRICOOL_BLOG_ID=8109476
METRICOOL_AUTO_PUBLISH=0
# The Render service's existing public HTTPS origin for one-time transfer URLs.
RENDER_EXTERNAL_URL=https://twitch-gta6-clipping.onrender.com
